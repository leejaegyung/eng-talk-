          "sql": "CREATE TABLE IF NOT EXISTS \"expressions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"phrase\" TEXT NOT NULL, \"meaning_ko\" TEXT NULL, \"source_session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE);"
        }
      ]
    },
