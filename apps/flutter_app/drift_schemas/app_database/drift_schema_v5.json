      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"locale\" TEXT NOT NULL DEFAULT 'ko', \"target_minutes\" INTEGER NOT NULL DEFAULT 30, \"active_level\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "providers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"providers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"model_id\" TEXT NULL, \"vault_key_ref\" TEXT NOT NULL, \"settings_json\" TEXT NOT NULL DEFAULT '{}');"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"mode\" TEXT NOT NULL, \"topic\" TEXT NULL, \"level\" TEXT NULL, \"goal\" TEXT NULL, \"role\" TEXT NULL, \"length_minutes\" INTEGER NOT NULL DEFAULT 30, \"feedback_json\" TEXT NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"status\" TEXT NOT NULL, \"provider_id\" INTEGER NULL REFERENCES providers (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "turns",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"turns\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"speaker\" TEXT NOT NULL, \"transcript\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"word_count\" INTEGER NOT NULL DEFAULT 0, \"is_request\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_request\" IN (0, 1)), \"speech_ms\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "speech_metrics",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"speech_metrics\" (\"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"user_ms\" INTEGER NOT NULL DEFAULT 0, \"assistant_ms\" INTEGER NOT NULL DEFAULT 0, \"turn_count\" INTEGER NOT NULL DEFAULT 0, \"confidence\" REAL NULL, PRIMARY KEY (\"session_id\"));"
        }
      ]
    },
    {
      "name": "corrections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"corrections\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"turn_id\" INTEGER NOT NULL REFERENCES turns (id) ON DELETE CASCADE, \"original\" TEXT NOT NULL, \"suggested\" TEXT NOT NULL, \"explanation\" TEXT NULL, \"practiced\" INTEGER NOT NULL DEFAULT 0 CHECK (\"practiced\" IN (0, 1)), \"severity\" TEXT NULL, \"practice_prompt\" TEXT NULL, \"category\" TEXT NULL, \"kind\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"name\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    },
